{
  "name": "farlands-live",
  "private": true,
  "packageManager": "bun@1.2.21",
  "workspaces": ["packages/*", "apps/api", "apps/web"],
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22"
  },
  "scripts": {
    "mock": "bun run --cwd apps/api mock",
    "dev:api": "bun run --cwd apps/api mock",
    "dev:web": "bun run --cwd apps/web dev",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3",
    "bun-types": "^1.2.21"
  }
}
